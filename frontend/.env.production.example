# Databeat LMS — Frontend production environment template.
#
# Vite only ever bakes VITE_-prefixed variables into the build at build time (not runtime) —
# copy this to `.env.production` (or pass equivalently via your CI/host's build-time env
# vars) before running `npm run build`. See ../docs/DEPLOYMENT.md (repo root) for the full
# deployment walkthrough. For local development use `.env.example` instead.

# Base URL of the deployed backend API, INCLUDING the version prefix. Must be reachable from
# the browsers of everyone using the app (a public HTTPS URL, not localhost, in production),
# and must exactly match one of the backend's CORS_ORIGIN entries' scheme+host+port on the
# frontend side of the pairing (i.e. the frontend's own deployed origin needs to be in the
# backend's CORS_ORIGIN — this variable is just where the frontend calls out TO).
VITE_API_URL=https://api.yourcompany.com/api/v1

# Vite's own built-in mode flag — set automatically by `vite build` (production) vs
# `vite dev` (development); you do not need to set this yourself.
# MODE=production
