# Server
PORT=5000
NODE_ENV=development

# Neon PostgreSQL connection string (pooled). See ARCHITECTURE.md §6.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-000000.region.aws.neon.tech/databeat_lms?sslmode=require

# JWT (see ARCHITECTURE.md §9). Generate strong random secrets — never reuse across environments.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES=15m
REFRESH_EXPIRES=7d

# Local file storage root (see ARCHITECTURE.md §13).
UPLOAD_PATH=./src/uploads

# Comma-separated list of allowed frontend origins (see ARCHITECTURE.md §17).
CORS_ORIGIN=http://localhost:5173

# Seed-only (backend/src/prisma/seed.ts): the first Super Admin account created on a fresh
# database. Override in any shared environment — the seeded password must be changed on
# first login, which is enforced server-side (see require-password-change.middleware.ts).
ADMIN_EMAIL=admin@lmsplatform.com
ADMIN_PASSWORD=ChangeMe@123

# AI Learning Assistant (Prompt 7) — swappable provider (see src/modules/ai/README.md).
# Optional — the /ai/chat endpoint (and AI lesson-quiz generation) return 503 gracefully when
# the active provider's key is unset, rather than the app failing to boot.
#
# AI_PROVIDER selects which vendor is active: "openai" (default) or "anthropic". Only that
# vendor's key is actually used — setting the other vendor's key alone has no effect.
AI_PROVIDER=openai

# Used when AI_PROVIDER=openai (the default). Get a key at https://platform.openai.com/
MAIN_OPENAI_API_KEY=
MAIN_OPENAI_MODEL=gpt-5.3-codex

# Used when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL_ID=claude-opus-4-8
