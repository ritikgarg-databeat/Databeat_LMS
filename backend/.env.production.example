# Databeat LMS — Backend production environment template.
#
# Copy to `.env` on the production host (never commit the real file) and fill in every
# value marked REQUIRED. See ../ARCHITECTURE.md and docs/DEPLOYMENT.md (repo root) for the
# full deployment walkthrough. For local development use `.env.example` instead — several
# defaults below are deliberately stricter here (e.g. CORS_ORIGIN has no fallback in
# production; see src/config/env.ts).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
TRUST_PROXY=true
# API processes must keep this false. Run exactly one separate worker process.
RUN_SCHEDULER=false
# Shared rate-limit counters are required when more than one API process can serve traffic.
RATE_LIMIT_STORE=postgres
EXPIRED_SECURITY_DATA_RETENTION_DAYS=30
# Opt in only after approving the organization's retention policy.
RUN_RETENTION_CLEANUP=false

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
# Use Neon's POOLED connection string in production (the one with `-pooler` in the host),
# not the direct connection Prisma Migrate uses — see docs/DEPLOYMENT.md § Database.
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_POOL_WARM_CONNECTIONS=2
DATABASE_WORKER_POOL_MAX=1
DATABASE_WORKER_POOL_WARM_CONNECTIONS=1

# ---------------------------------------------------------------------------
# JWT (REQUIRED) — generate strong, unique random secrets for this environment.
# Never reuse a value from .env.example, another environment, or version control.
# e.g. `openssl rand -base64 48`
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-unique-to-production
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-unique-to-production
JWT_EXPIRES=15m
REFRESH_EXPIRES=7d
REFRESH_EXPIRES_REMEMBER_ME=30d

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Local disk storage — fine for a single-instance deployment. If you scale to multiple
# backend instances behind a load balancer, this path must be on shared/networked storage
# (or the storage provider swapped for an object-storage implementation — see
# src/storage/storage-provider.interface.ts) since uploads land on whichever instance
# served the request.
UPLOAD_PATH=/var/data/databeat-lms/uploads

# ---------------------------------------------------------------------------
# Security (REQUIRED)
# ---------------------------------------------------------------------------
# Comma-separated, exact origin(s) of the deployed frontend — no wildcard, no trailing
# slash. REQUIRED in production: the app now fails to boot if this is unset, rather than
# silently falling back to the dev origin (src/config/env.ts). Setting this to the WRONG
# origin (as opposed to leaving it unset) is not caught automatically — double-check it
# matches exactly what the frontend is actually deployed at.
CORS_ORIGIN=https://lms.yourcompany.com
PASSWORD_RESET_URL=https://lms.yourcompany.com/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=30
# HTTPS endpoint accepting { type, to, resetUrl, expiresAt }.
EMAIL_WEBHOOK_URL=https://mailer.yourcompany.com/hooks/databeat
EMAIL_WEBHOOK_BEARER_TOKEN=replace-with-a-delivery-service-token

# ---------------------------------------------------------------------------
# Super Admin seed credentials
# ---------------------------------------------------------------------------
# Read once by `npm run seed` to create the first Super Admin account on a fresh database.
# Change these from the example defaults before seeding a real production database — the
# account is forced to change its password on first login regardless (see
# require-password-change.middleware.ts), but starting from a non-public email/password
# pair is still better practice than relying on that gate alone.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=set-a-strong-temporary-password-here

# ---------------------------------------------------------------------------
# AI Tutor + lesson-quiz generation (optional — degrades to 503 if unset rather than failing
# to boot). AI_PROVIDER picks the active vendor; set the matching key/model pair below it.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
MAIN_OPENAI_API_KEY=
MAIN_OPENAI_MODEL=gpt-5.3-codex
ANTHROPIC_API_KEY=
AI_MODEL_ID=claude-opus-4-8
